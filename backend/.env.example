# .env.example — Copy this file to .env and fill in your own values.
# Never put real secrets in this file — it is safe to commit to GitHub.

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=ticketsaathi_db
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

GOOGLE_CLIENT_ID=get-this-from-google-cloud-console
GOOGLE_CLIENT_SECRET=get-this-from-google-cloud-console
